{
  "name": "labs-jordan-t-dev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm generate:tokens && astro dev",
    "build": "pnpm generate:tokens && astro check && astro build",
    "preview": "astro preview",
    "generate:tokens": "tsx scripts/generate-tokens.ts",
    "test": "vitest run",
    "lint": "run-s lint:es lint:css",
    "lint:es": "eslint .",
    "lint:css": "run-s lint:stylelint lint:breakpoints",
    "lint:stylelint": "stylelint \"src/**/*.{css,astro}\"",
    "lint:breakpoints": "node .ai/skills/breakpoints-check/check-custom-media.mjs",
    "format": "prettier --write ./src --ignore-path .gitignore"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/preact": "^6.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/geist-sans": "^5.2.5",
    "astro": "^7.0.3",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@csstools/postcss-global-data": "^4.0.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.0.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^2.1.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "postcss-custom-media": "^12.0.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
