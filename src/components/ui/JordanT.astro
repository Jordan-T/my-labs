---
import { Image } from "astro:assets";
import portrait from "@/assets/jordan-t-portrait.svg";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["wrap", className]}>
  <span class="hex" aria-hidden="true"></span>
  {/* The wrapper isolates the one-shot slide-up so each element carries a
      single transform animation (wrap float / reveal slide / photo float):
      two transform animations on one element fall back to the main thread. */}
  <span class="reveal">
    <Image
      src={portrait}
      width={240}
      height={240}
      alt="Portrait de Jordan Taisne"
      loading="eager"
    />
  </span>
</div>

<style>
  .wrap {
    --float-height: 0.5rem;
    --width: clamp(9.375rem, 30vw, 21.875rem);

    position: relative;
    width: var(--width);
    height: calc(var(--width) * 3 / 2);
    clip-path: polygon(
      50% 0%,
      100% 0%,
      100% calc(100% - var(--width) * 1.1547 * 0.25),
      50% 100%,
      0% calc(100% - var(--width) * 1.1547 * 0.25),
      0% 0%
    );
    animation: float 10s ease-in-out infinite;
    will-change: transform;
  }

  .hex {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: calc(var(--width) * 1.1547);
    background: var(--color-surface-accent-raised);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  }

  .reveal {
    position: absolute;
    inset: 0;
    animation: appear 1.25s var(--transition-base) both;
  }

  /* The portrait is rendered by <Image>, so it is targeted as a global child. */
  .reveal :global(img) {
    --float-height: -1rem;

    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: float 10s ease-in-out infinite 1s;
    will-change: transform;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(calc(-1 * var(--float-height, 0.5rem)));
    }
  }

  @keyframes appear {
    0% {
      transform: translate3d(0, 100%, 0);
    }
  }
</style>
