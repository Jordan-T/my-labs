<form
  action="#"
  method="post"
  enctype="multipart/form-data"
  id="enregistrement-parure-form"
  class="enregistrement-parure-form"
>
  <a href="#" id="back-to-configurateur" class="p_return"
    >Modifier ma création</a
  >

  <div id="error"></div>

  <h2>hidden inputs for the configurator data:</h2>

  style:
  <input type="text" readonly value="" name="input_style" id="input_style" />

  creation:
  <textarea
    readonly
    value=""
    name="input_creation"
    id="input_creation"
    cols="60"
    rows="20"
    style="width:100%; height:200px"></textarea>

  <br />
  width:
  <input type="text" readonly value="" name="input_width" id="input_width" />
  height:
  <input type="text" readonly value="" name="input_height" id="input_height" />
  color:
  <input type="text" readonly value="" name="input_color" id="input_color" />

  <div class="submit-container">
    <button
      type="button"
      name="submit"
      id="submit"
      class="button button-submit"
      value="je valide !"
    >
      je valide !
    </button>
  </div>
</form>
