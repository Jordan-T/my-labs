---
import { siteConfig } from "@/config/site";
import HexButton from "@/components/ui/HexButton.astro";
import SocialIcon from "@/components/ui/SocialIcon.astro";
---

<footer class="footer">
  <div class="socials">
    {
      siteConfig.socials.map((social) => (
        <HexButton label={social.label} size="small" href={social.url} newTab>
          <SocialIcon label={social.label} />
        </HexButton>
      ))
    }
  </div>

  <p class="credit">
    Conçu et codé par <a
      class="link"
      href={siteConfig.portfolio.url}
      rel="noopener">Jordan Taisne</a
    >.
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--gutter);
    background: var(--color-bg);
    border-top: 1px solid var(--border-accent-soft);
    text-align: center;
    font-size: var(--fs-label);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .link {
    color: currentColor;
    transition: color var(--transition-base);
  }

  .link:hover,
  .link:focus {
    color: var(--color-accent);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
  }
</style>
