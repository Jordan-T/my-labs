---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import ExperimentCard from "@/components/cards/ExperimentCard.astro";
import JordanT from "@/components/ui/JordanT.astro";
import { getPublishedExperiments } from "@/lib/experiments";
import { siteConfig } from "@/config/site";

const experiments = await getPublishedExperiments();
---

<BaseLayout>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Terrain d'expérimentation</p>
      <h1 class="title">Jordan Taisne <span>Labs</span></h1>
      <p class="desc">
        Le terrain de jeu où j'explore des idées techniques : démonstrations
        CSS, animations, performance, petits POCs. Chaque expérience vient avec
        une démo et une courte explication. Mon travail durable, lui, vit sur le
        portfolio.
      </p>
      <div class="ctas">
        <a class="cta cta-primary" href="#experiences">Explorer les expériences</a>
        <a class="cta cta-link" href={siteConfig.portfolio.url} rel="noopener">
          Voir mon portfolio
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <JordanT />
    </div>
  </section>

  <Section>
    <h2 id="experiences" class="gallery-title">Expériences</h2>
    {
      experiments.length > 0 ? (
        <ul class="grid">
          {experiments.map((experiment) => (
            <li>
              <ExperimentCard experiment={experiment} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Les premières expériences arrivent bientôt.</p>
      )
    }
  </Section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: var(--space-4xl);
    max-width: var(--maxw);
    margin-inline: auto;
    padding: var(--space-4xl) var(--gutter);
  }

  .hero-content {
    flex: 1;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .eyebrow::before {
    content: "";
    width: 2.5rem;
    height: var(--border-width);
    background: var(--color-accent);
  }

  .title {
    margin-bottom: var(--space-lg);
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    line-height: 1;
    color: var(--color-white);
  }

  .title span {
    color: var(--color-accent);
  }

  .desc {
    max-width: 32rem;
    margin-bottom: var(--space-2xl);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .cta-primary {
    padding: var(--space-sm) var(--space-lg);
    color: var(--color-bg);
    background: var(--color-accent);
    border: var(--border-width) solid var(--color-accent);
    border-radius: var(--radius-sm);
    transition:
      background var(--transition-base),
      transform var(--transition-base);
  }

  .cta-primary:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, var(--color-white));
    transform: translateY(-0.125rem);
  }

  .cta-link {
    color: var(--color-accent);
  }

  .cta-link:hover {
    text-decoration: underline;
  }

  .hero-visual {
    flex-shrink: 0;
  }

  .gallery-title {
    margin-bottom: var(--space-xl);
    font-size: 1.75rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-lg);
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (--mq-grid) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xl);
      padding-top: var(--space-3xl);
    }
  }

  @media (--mq-compact) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
