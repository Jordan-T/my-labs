---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import ExperimentCard from "@/components/cards/ExperimentCard.astro";
import JordanT from "@/components/ui/JordanT.astro";
import Button from "@/components/ui/Button.astro";
import { getPublishedExperiments } from "@/lib/experiments";
import { siteConfig } from "@/config/site";

const experiments = await getPublishedExperiments();
---

<BaseLayout>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Terrain d'expérimentation</p>
      <h1 class="title">Jordan Taisne <span>Labs</span></h1>
      <p class="desc">
        Le terrain de jeu où j'explore des idées techniques : démonstrations
        CSS, animations, performance, petits POCs. Chaque expérience vient avec
        une démo et une courte explication. Mon travail durable, lui, vit sur le
        portfolio.
      </p>
      <div class="ctas">
        <Button href="#experiences">Explorer les expériences</Button>
        <Button
          variant="secondary"
          href={siteConfig.portfolio.url}
          rel="noopener"
        >
          Voir mon portfolio
        </Button>
      </div>
    </div>
    <div class="hero-visual">
      <JordanT />
    </div>
  </section>

  <Section>
    <h2 id="experiences" class="gallery-title">Expériences</h2>
    {
      experiments.length > 0 ? (
        <ul class="grid">
          {experiments.map((experiment) => (
            <li>
              <ExperimentCard experiment={experiment} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Les premières expériences arrivent bientôt.</p>
      )
    }
  </Section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: var(--space-4xl);
    max-width: var(--maxw);
    margin-inline: auto;
    padding: var(--space-4xl) var(--gutter);
  }

  .hero-content {
    flex: 1;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .eyebrow::before {
    content: "";
    width: 2.5rem;
    height: var(--border-width);
    background: var(--color-accent);
  }

  .title {
    margin-bottom: var(--space-lg);
    font-size: var(--fs-hero);
    line-height: var(--lh-solid);
    color: var(--color-white);
  }

  .title span {
    color: var(--color-accent);
  }

  .desc {
    max-width: 32rem;
    margin-bottom: var(--space-2xl);
    line-height: var(--lh-relaxed);
    font-size: var(--fs-body);
    color: var(--color-text-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero-visual {
    flex-shrink: 0;
  }

  .gallery-title {
    margin-bottom: var(--space-xl);
    font-size: var(--fs-h2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(25rem, 1fr));
    gap: var(--space-lg);
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (--mq-grid) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xl);
      padding-top: var(--space-3xl);
    }
  }

  @media (--mq-compact) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
